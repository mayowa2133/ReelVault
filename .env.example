TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
TELEGRAM_WEBHOOK_SECRET=
BASE_URL=
PROCESSING_BACKEND=background

OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_ANALYSIS_MODEL=gpt-4.1-mini

GOOGLE_OAUTH_CLIENT_SECRET_FILE=/secrets/credentials.json
GOOGLE_OAUTH_TOKEN_FILE=/secrets/token.json
GOOGLE_OAUTH_TOKEN_JSON=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB_NAME=Reels

GCP_PROJECT_ID=
GCP_LOCATION=us-central1
CLOUD_TASKS_QUEUE=reelvault-processing
CLOUD_TASKS_TARGET_URL=
TASK_REQUEST_SECRET=
CLOUD_TASKS_DISPATCH_DEADLINE_SECONDS=1800
CLOUD_TASKS_CREATE_TIMEOUT_SECONDS=30

TEMP_DIR=/tmp/reelvault
MAX_VIDEO_SIZE_MB=100
MAX_AUDIO_SIZE_MB=24
ENABLE_VIDEO_DOWNLOAD=true
ENABLE_AUDIO_UPLOAD=true
ENABLE_DEBUG_LOGGING=false
